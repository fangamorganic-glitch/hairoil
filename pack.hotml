<!DOCTYPE html>
<html lang="ur" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fangam Organic - Courier Dispatch Generator</title>
  
  <!-- Barcode & QR Code Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --primary: #1b4332;
      --primary-light: #2d6a4f;
      --bg: #f4f7f6;
      --card: #ffffff;
      --text: #2b2b2b;
      --border: #dcdcdc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 20px; }
    .container { max-width: 900px; margin: 0 auto; }

    .header-panel {
      background: var(--primary);
      color: white;
      padding: 18px 25px;
      border-radius: 12px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .header-panel h1 { font-size: 20px; display: flex; align-items: center; gap: 10px; }

    .control-card {
      background: var(--card);
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      margin-bottom: 25px;
      border: 1px solid var(--border);
    }

    .section-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--primary-light);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }

    .form-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
    .form-group label { font-size: 12px; font-weight: 700; color: #444; }
    .form-group input, .form-group textarea, .form-group select {
      padding: 9px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 13px;
      outline: none;
    }

    .btn {
      padding: 10px 18px;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s;
      font-size: 13px;
    }
    .btn-fetch { background: var(--primary-light); color: white; height: 42px; }
    .btn-fetch:hover { background: var(--primary); }
    .btn-generate { background: #27ae60; color: white; width: 100%; font-size: 15px; padding: 12px; margin-top: 10px; }
    .btn-generate:hover { background: #219150; }
    .btn-print { background: #2980b9; color: white; font-size: 14px; padding: 10px 20px; }
    .btn-print:hover { background: #1c5980; }

    /* Print Label Design */
    .label-wrapper { display: none; justify-content: center; margin-top: 20px; }
    
    .shipping-label {
      width: 4.1in;
      min-height: 6.2in;
      background: white;
      border: 2px solid #000;
      padding: 10px;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
      color: #000;
      position: relative;
    }

    .label-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #000;
      padding-bottom: 6px;
      margin-bottom: 6px;
    }

    .brand-logo-area { max-width: 170px; max-height: 50px; }
    .brand-logo-area img { max-width: 100%; max-height: 50px; object-fit: contain; }
    .brand-text-fallback { font-weight: 900; font-size: 18px; text-transform: uppercase; letter-spacing: 0.5px; }

    .ship-type { text-align: right; }
    .ship-type .type-title { font-size: 18px; font-weight: 900; text-transform: uppercase; }
    .ship-type .sub-tag { font-size: 10px; font-weight: bold; border: 1px solid #000; padding: 1px 4px; display: inline-block; }

    .barcode-section { text-align: center; border-bottom: 2px solid #000; padding: 4px 0; }
    .barcode-section svg { width: 92%; height: 50px; }

    .details-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
    .details-table td { border: 1px solid #000; padding: 3px 5px; font-size: 10px; }
    .details-table td.label-key { font-weight: bold; width: 26%; background: #f0f0f0; }
    .details-table td.label-val { font-weight: bold; }

    .consignee-box { border: 2px solid #000; padding: 6px; margin-bottom: 6px; background: #fafafa; position: relative; }
    .consignee-header { font-size: 9px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px; border-bottom: 1px solid #000; }
    .consignee-name { font-size: 15px; font-weight: 900; text-transform: uppercase; }
    .consignee-phone { font-size: 13px; font-weight: bold; margin: 2px 0; }
    .consignee-city { font-size: 16px; font-weight: 900; float: right; text-transform: uppercase; background: #000; color: #fff; padding: 2px 6px; }
    .consignee-address { font-size: 11px; margin-top: 4px; line-height: 1.2; font-weight: 600; }

    .items-box { border: 1px solid #000; padding: 4px 6px; font-size: 10px; margin-bottom: 6px; background: #fff; }
    .items-title { font-weight: bold; font-size: 9.5px; border-bottom: 1px solid #ddd; padding-bottom: 2px; margin-bottom: 2px; }

    .cod-amount-box { border: 2px solid #000; text-align: center; padding: 4px; margin-bottom: 6px; background: #fff; }
    .cod-amount-box .cod-title { font-size: 10px; font-weight: bold; }
    .cod-amount-box .cod-val { font-size: 20px; font-weight: 900; }

    .shipper-box { border: 1px solid #000; padding: 5px; font-size: 9.5px; margin-bottom: 6px; }
    .instructions-box { border: 1px dashed #000; padding: 4px; font-size: 9px; font-weight: bold; }

    .label-footer { margin-top: 6px; display: flex; justify-content: space-between; align-items: center; }
    #qrcode img { width: 50px !important; height: 50px !important; }

    .print-actions { display: flex; justify-content: center; gap: 15px; margin-top: 15px; }

    @media print {
      body * { visibility: hidden; }
      .label-wrapper, .label-wrapper * { visibility: visible; }
      .label-wrapper { display: flex !important; position: absolute; left: 0; top: 0; width: 100%; }
      .shipping-label { border: 2px solid #000 !important; width: 4in !important; box-shadow: none !important; }
      .print-actions { display: none !important; }
    }
  </style>
</head>
<body>

<div class="container">
  
  <div class="header-panel">
    <h1><i class="fa-solid fa-box-archive"></i> Fangam Organic Dispatch Engine</h1>
    <span>Connected to Google Sheet</span>
  </div>

  <div class="control-card">
    
    <!-- Fetch Bar -->
    <div class="section-title">
      <i class="fa-solid fa-magnifying-glass"></i> 1. Enter Order ID
    </div>
    
    <div style="display: flex; gap: 10px; margin-bottom: 15px;">
      <input type="text" id="fetchOrderId" placeholder="Enter Order ID (e.g. 1001)..." style="flex: 1; font-size: 16px; padding: 10px 14px;" onkeypress="if(event.key==='Enter') fetchDataFromSheet()">
      <button type="button" class="btn btn-fetch" onclick="fetchDataFromSheet()"><i class="fa-solid fa-cloud-arrow-down"></i> Fetch Order Data</button>
    </div>

    <!-- Details Box -->
    <div class="section-title">
      <i class="fa-solid fa-sliders"></i> 2. Fetched Data Preview & Manual Editing
    </div>

    <form id="labelForm">
      <div class="grid-3">
        <div class="form-group">
          <label>Order ID (Col A):</label>
          <input type="text" id="orderId" readonly style="background: #eee;">
        </div>
        <div class="form-group">
          <label>Date & Time (Col B):</label>
          <input type="text" id="bookDate" readonly style="background: #eee;">
        </div>
        <div class="form-group">
          <label>Product Type (Col C):</label>
          <input type="text" id="productType" readonly style="background: #eee;">
        </div>
      </div>

      <div class="grid-3">
        <div class="form-group">
          <label>Customer Name (Col D):</label>
          <input type="text" id="custName">
        </div>
        <div class="form-group">
          <label>Phone / WhatsApp (Col E):</label>
          <input type="text" id="custPhone">
        </div>
        <div class="form-group">
          <label>City (Col F):</label>
          <input type="text" id="custCity">
        </div>
      </div>

      <div class="form-group">
        <label>Delivery Address (Col G):</label>
        <textarea id="custAddress" rows="2"></textarea>
      </div>

      <div class="form-group">
        <label>Order Items & Qty (Col H):</label>
        <input type="text" id="orderItems">
      </div>

      <div class="grid-3">
        <div class="form-group">
          <label>Subtotal (Col I):</label>
          <input type="text" id="subtotal">
        </div>
        <div class="form-group">
          <label>Discount (Col J):</label>
          <input type="text" id="discount">
        </div>
        <div class="form-group">
          <label>Grand Total (Col K):</label>
          <input type="text" id="grandTotal">
        </div>
      </div>

      <div class="grid-3">
        <div class="form-group">
          <label>Advance Paid (Col L):</label>
          <input type="text" id="advancePaid">
        </div>
        <div class="form-group">
          <label>Remaining COD PKR (Col M):</label>
          <input type="text" id="remainingCod" style="font-weight: bold; color: #c0392b;">
        </div>
        <div class="form-group">
          <label>Payment Status (Col N):</label>
          <input type="text" id="paymentStatus">
        </div>
      </div>

      <div class="grid-2" style="margin-top: 10px;">
        <div class="form-group">
          <label>Tracking Code (Col O / Manual Feed):</label>
          <input type="text" id="trackingNo" placeholder="Enter or Auto Fetched from Col O">
        </div>
        <div class="form-group">
          <label>Courier Service Type:</label>
          <select id="parcelType">
            <option value="OVERNIGHT">OVERNIGHT</option>
            <option value="SAME DAY">SAME DAY</option>
            <option value="STANDARD">STANDARD</option>
          </select>
        </div>
      </div>

      <button type="button" class="btn btn-generate" onclick="generateInvoiceLabel()">
        <i class="fa-solid fa-receipt"></i> Generate Dispatch Receipt & Barcode
      </button>
    </form>

  </div>

  <!-- Dispatch Receipt Output Box -->
  <div class="label-wrapper" id="labelOutputWrapper">
    <div>
      <div class="shipping-label" id="printableLabel">
        
        <!-- Header -->
        <div class="label-header">
          <div class="brand-logo-area" id="brandLogoContainer">
            <!-- Fixed Logo Image -->
            <img src="https://lh3.googleusercontent.com/d/1NJYUBfxZMMcO2Wqh_wzsuyUjeC-mi97V" alt="Fangam Organic" onerror="this.outerHTML='<span class=\\'brand-text-fallback\\'>FANGAM ORGANIC</span>'">
          </div>
          <div class="ship-type">
            <div class="type-title" id="lblParcelType">OVERNIGHT</div>
            <div class="sub-tag" id="lblPaymentMethod">COD PARCEL</div>
          </div>
        </div>

        <!-- Barcode Area -->
        <div class="barcode-section">
          <svg id="barcode"></svg>
        </div>

        <!-- Specs Grid -->
        <table class="details-table">
          <tr>
            <td class="label-key">Tracking #:</td>
            <td class="label-val" id="lblTracking">---</td>
            <td class="label-key">Order ID:</td>
            <td class="label-val" id="lblOrderId">---</td>
          </tr>
          <tr>
            <td class="label-key">Order Date:</td>
            <td class="label-val" id="lblBookDate">---</td>
            <td class="label-key">Print Date:</td>
            <td class="label-val" id="lblPrintDate">---</td>
          </tr>
          <tr>
            <td class="label-key">Origin:</td>
            <td class="label-val">SIALKOT</td>
            <td class="label-key">Type:</td>
            <td class="label-val" id="lblProdType">---</td>
          </tr>
        </table>

        <!-- Consignee / Receiver -->
        <div class="consignee-box">
          <span class="consignee-city" id="lblCity">CITY</span>
          <div class="consignee-header">CONSIGNEE / RECEIVER</div>
          <div class="consignee-name" id="lblName">CUSTOMER NAME</div>
          <div class="consignee-phone">Contact: <span id="lblPhone">0300XXXXXXX</span></div>
          <div class="consignee-address"><b>Address:</b> <span id="lblAddress">Customer Address</span></div>
        </div>

        <!-- Order Items Breakdown -->
        <div class="items-box">
          <div class="items-title">ORDER ITEMS SUMMARY:</div>
          <div id="lblItemsList">--</div>
        </div>

        <!-- COD Amount -->
        <div class="cod-amount-box">
          <div class="cod-title">CASH TO COLLECT (REMAINING COD)</div>
          <div class="cod-val">PKR <span id="lblCod">0.00</span></div>
        </div>

        <!-- Shipper Details -->
        <div class="shipper-box">
          <div><b>Shipper:</b> Fangam Organic (فینگم آرگینک)</div>
          <div><b>Contact:</b> 03000634445 | www.fangamorganic.com</div>
          <div><b>Address:</b> Village & Post Office Gondal, Tehsil & District Sialkot</div>
        </div>

        <!-- Special Instructions -->
        <div class="instructions-box">
          <b>Instructions:</b> Please call customer before delivery. Verify payment before opening.
        </div>

        <div class="label-footer">
          <small style="font-size: 8px;">Fangam Logistics System</small>
          <div id="qrcode"></div>
        </div>

      </div>

      <!-- Action Buttons -->
      <div class="print-actions">
        <button class="btn btn-print" onclick="window.print()">
          <i class="fa-solid fa-print"></i> Print Dispatch Receipt / Save PDF
        </button>
      </div>

    </div>
  </div>

</div>

<script>
  // EMBEDDED WEB APP URL
  const GOOGLE_SHEET_WEB_APP_URL = "https://script.google.com/macros/s/AKfycbzCwQV0LN2DAPPo7Rt2qbOrvLpjTvJKdpMUyliA_wZMtm-7UGWQl4wXtwNmWy5zpwheaQ/exec";
  const FIXED_LOGO_URL = "https://lh3.googleusercontent.com/d/1NJYUBfxZMMcO2Wqh_wzsuyUjeC-mi97V";

  function fetchDataFromSheet() {
    const orderId = document.getElementById('fetchOrderId').value.trim();

    if (!orderId) {
      alert("براہ کرم آرڈر آئی ڈی درج کریں۔");
      return;
    }

    fetch(`${GOOGLE_SHEET_WEB_APP_URL}?orderId=${encodeURIComponent(orderId)}`)
      .then(res => res.json())
      .then(data => {
        if (data.error) {
          alert("آرڈر آئی ڈی شیٹ میں نہیں مل سکی۔");
        } else {
          document.getElementById('orderId').value = data.orderId || orderId;
          document.getElementById('bookDate').value = data.dateTime || "";
          document.getElementById('productType').value = data.productType || "";
          document.getElementById('custName').value = data.custName || "";
          document.getElementById('custPhone').value = data.custPhone || "";
          document.getElementById('custCity').value = data.custCity || "";
          document.getElementById('custAddress').value = data.custAddress || "";
          document.getElementById('orderItems').value = data.orderItems || "";
          document.getElementById('subtotal').value = data.subtotal || "0";
          document.getElementById('discount').value = data.discount || "0";
          document.getElementById('grandTotal').value = data.grandTotal || "0";
          document.getElementById('advancePaid').value = data.advancePaid || "0";
          document.getElementById('remainingCod').value = data.remainingCod || "0";
          document.getElementById('paymentStatus').value = data.paymentStatus || "COD PARCEL";

          // Tracking ID from Column O or fallback
          document.getElementById('trackingNo').value = data.trackingNo || ("FO" + data.orderId);

          generateInvoiceLabel();
        }
      })
      .catch(err => {
        alert("ڈیٹا فیچ کرنے میں ایرر آیا: " + err);
      });
  }

  function generateInvoiceLabel() {
    document.getElementById('labelOutputWrapper').style.display = 'flex';

    // Logo Rendering
    const logoContainer = document.getElementById('brandLogoContainer');
    logoContainer.innerHTML = `<img src="${FIXED_LOGO_URL}" alt="Fangam Organic" onerror="this.outerHTML='<span class=\\'brand-text-fallback\\'>FANGAM ORGANIC</span>'">`;

    // Current Print Date
    const now = new Date();
    const printDateStr = now.toISOString().split('T')[0] + ' ' + now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
    document.getElementById('lblPrintDate').innerText = printDateStr;

    const tracking = document.getElementById('trackingNo').value || document.getElementById('orderId').value || "1001";
    const orderId = document.getElementById('orderId').value || "1001";

    document.getElementById('lblParcelType').innerText = document.getElementById('parcelType').value;
    document.getElementById('lblPaymentMethod').innerText = document.getElementById('paymentStatus').value || "COD PARCEL";
    
    document.getElementById('lblTracking').innerText = tracking;
    document.getElementById('lblOrderId').innerText = orderId;
    document.getElementById('lblBookDate').innerText = document.getElementById('bookDate').value || printDateStr.split(' ')[0];
    document.getElementById('lblProdType').innerText = document.getElementById('productType').value || "General";

    document.getElementById('lblName').innerText = document.getElementById('custName').value || "CUSTOMER";
    document.getElementById('lblPhone').innerText = document.getElementById('custPhone').value || "---";
    document.getElementById('lblCity').innerText = (document.getElementById('custCity').value || "SIALKOT").toUpperCase();
    document.getElementById('lblAddress').innerText = document.getElementById('custAddress').value || "---";

    document.getElementById('lblItemsList').innerText = document.getElementById('orderItems').value || "---";
    document.getElementById('lblCod').innerText = document.getElementById('remainingCod').value || "0.00";

    // Render Barcode
    JsBarcode("#barcode", tracking, {
      format: "CODE128",
      lineColor: "#000",
      width: 2,
      height: 48,
      displayValue: true,
      fontSize: 13,
      fontOptions: "bold"
    });

    // Render QR Code
    document.getElementById('qrcode').innerHTML = "";
    new QRCode(document.getElementById('qrcode'), {
      text: `TRACK:${tracking}|ORD:${orderId}|COD:${document.getElementById('remainingCod').value}|CITY:${document.getElementById('custCity').value}`,
      width: 50,
      height: 50
    });

    document.getElementById('labelOutputWrapper').scrollIntoView({ behavior: 'smooth' });
  }
</script>

</body>
</html>
